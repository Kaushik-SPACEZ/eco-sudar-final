# Build config for the TEST environment (test.ecosudar.com).
# Used by `npm run build:test` (vite build --mode test) so the test admin
# talks to the test API, not production. Production builds use `.env` (npm run build).
VITE_API_BASE_URL="https://test.ecosudar.com/api"
VITE_USE_MOCK_API="false"
# Serve the SPA from the domain root (test.ecosudar.com/, no /admin in the URL).
# Absolute asset paths (/assets/...) so nested-route reloads don't 404.
# The root .htaccess rewrites /assets/* -> /admin/assets/* where the files live.
VITE_BASE_PATH="/"
