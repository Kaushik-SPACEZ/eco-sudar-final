# Copy this file to .env and fill in real values. NEVER commit .env (it is gitignored).
#
# ── Database ────────────────────────────────────────────────────────────────────
# On the DEPLOYED Hostinger server, DB_HOST should be: localhost  (fast local socket).
# To run the backend LOCALLY against the remote DB, use the remote host shown in
# hPanel → Databases (e.g. srvXXXX.hstgr.io) AND whitelist your IP in Remote MySQL.
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASS=your-db-password

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Generate a new secret: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=your-64-char-hex-secret

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (admin dashboard + local dev ports).
CORS_ORIGIN=https://your-domain.com,http://localhost:8080,http://localhost:8081

# ── Cron ────────────────────────────────────────────────────────────────────────
# Shared secret that the attendance auto-absent cron (api/cron/mark_absent.php)
# requires when triggered over HTTP (wget/curl). Must be non-empty or the endpoint
# returns 403. Generate one: php -r "echo bin2hex(random_bytes(24));"
CRON_KEY=your-cron-secret

# ── AI API Keys ─────────────────────────────────────────────────────────────────
gemini_api_key=your-gemini-key
groq_api_key=your-groq-key
groq_api_key_new=your-groq-key
